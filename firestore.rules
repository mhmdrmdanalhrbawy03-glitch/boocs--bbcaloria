rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() && (
        request.auth.token.email == 'ramadanh66778@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin'])
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isTeacher());
      allow list: if isTeacher();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isTeacher();
    }

    // Educational Books collection
    match /books/{bookId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // Evaluations & Weekly Homeworks
    match /evaluations/{evalId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // Quizzes and Exams
    match /exams/{examId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // Student Favorites
    match /favorites/{favId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isTeacher());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }
  }
}
